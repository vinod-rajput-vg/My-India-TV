rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public channel data is read-only to apps and viewers.
    match /channels/{channelId} {
      allow read: if true;

      // Replace this value with the Firebase Authentication UID of the
      // administrator account. Never use email supplied by the client as
      // the sole authorization check.
      allow create, update, delete: if request.auth != null
        && request.auth.uid == "zsTttRoLLSSExtA0vL66LrBQiLz1";
    }

    // Deny access to every collection not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
